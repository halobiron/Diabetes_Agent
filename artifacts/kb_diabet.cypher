// --- Remove items left over from older KB versions ---
MATCH ()-[r]->() WHERE r.kb_version <> 'corpus-2026-11-08' DELETE r;
MATCH (n) WHERE (n:Entity OR n:Evidence OR n:Source) AND n.kb_version <> 'corpus-2026-11-08' DETACH DELETE n;
